####################################################################################
# Constraints from file : 'fpga.xdc'
####################################################################################

# XDC constraints for the ADM-PCIE-9V3
# part: xcvu3p-ffvc1517-2-i

# General configuration
current_instance -quiet
set_property CFGBVS GND [current_design]
set_property CONFIG_VOLTAGE 1.8 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.EXTMASTERCCLK_EN DIV-1 [current_design]
set_property BITSTREAM.CONFIG.SPI_32BIT_ADDR YES [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 8 [current_design]
set_property BITSTREAM.CONFIG.SPI_FALL_EDGE YES [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLNONE [current_design]
set_property BITSTREAM.CONFIG.OVERTEMPSHUTDOWN ENABLE [current_design]

# 300 MHz system clock
set_property IOSTANDARD LVDS [get_ports clk_300mhz_p]
set_property DIFF_TERM_ADV TERM_100 [get_ports clk_300mhz_p]
set_property IOSTANDARD LVDS [get_ports clk_300mhz_n]
set_property DIFF_TERM_ADV TERM_100 [get_ports clk_300mhz_n]
create_clock -period 3.333 -name clk_300mhz [get_ports clk_300mhz_p]

# 300 MHz memory clock (C0)
set_property -dict {LOC G31 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports mem_clk_300mhz_0_p]
set_property -dict {LOC G32 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports mem_clk_300mhz_0_n]
# create_clock -period 3.333 -name mem_clk_300mhz_0 [get_ports mem_clk_300mhz_0_p]

# 300 MHz memory clock (C1)
set_property -dict {LOC AN25 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports mem_clk_300mhz_1_p]
set_property -dict {LOC AN26 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports mem_clk_300mhz_1_n]
# create_clock -period 3.333 -name mem_clk_300mhz_1 [get_ports mem_clk_300mhz_1_p]

# LEDs
set_property IOSTANDARD LVCMOS18 [get_ports {user_led_g[0]}]
set_property SLEW SLOW [get_ports {user_led_g[0]}]
set_property DRIVE 12 [get_ports {user_led_g[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {user_led_g[1]}]
set_property SLEW SLOW [get_ports {user_led_g[1]}]
set_property DRIVE 12 [get_ports {user_led_g[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports user_led_r]
set_property SLEW SLOW [get_ports user_led_r]
set_property DRIVE 12 [get_ports user_led_r]
set_property IOSTANDARD LVCMOS18 [get_ports {front_led[0]}]
set_property SLEW SLOW [get_ports {front_led[0]}]
set_property DRIVE 12 [get_ports {front_led[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {front_led[1]}]
set_property SLEW SLOW [get_ports {front_led[1]}]
set_property DRIVE 12 [get_ports {front_led[1]}]

set_false_path -to [get_ports {{user_led_g[*]} user_led_r {front_led[*]}}]
set_output_delay 0.000 [get_ports {{user_led_g[*]} user_led_r {front_led[*]}}]

# Switches
set_property -dict {LOC AV27 IOSTANDARD LVCMOS18} [get_ports {user_sw[0]}]
set_property -dict {LOC AW27 IOSTANDARD LVCMOS18} [get_ports {user_sw[1]}]

set_false_path -from [get_ports {user_sw[*]}]
set_input_delay 0.000 [get_ports {user_sw[*]}]

# GPIO
